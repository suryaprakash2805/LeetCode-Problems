class Solution {
    public int[] singleNumber(int[] nums) {
        int xor = 0;
        for(int num : nums){
            xor ^= num;
        }
        int rightMostBit = (xor & (xor-1)) ^ xor;
        int xor1 = 0;
        int xor2 = 0;
        for(int num : nums){
           if((num & rightMostBit) != 0) xor1 ^= num;
           else xor2 ^= num;
        }
        if(xor2 > xor1) return new int[]{xor1, xor2};
        return new int[]{xor2, xor1};
    }
}
