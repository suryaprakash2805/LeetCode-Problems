class Solution {
    public int totalFruit(int[] fruits) {
        int left = -1;
        int right = -1;
        int len = 0;
        int streak = 0;
        int maxLen = 0;
        for(int fruit : fruits){
            if(left == fruit || right == fruit) len++;
            else len = streak + 1 ;

            if(right == fruit) streak++;
            else{
                streak = 1;
                left = right;
                right = fruit;
            }
            maxLen = Math.max(maxLen, len);
        }
        return maxLen;
    }
}
