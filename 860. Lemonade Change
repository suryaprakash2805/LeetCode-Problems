class Solution {
    public boolean lemonadeChange(int[] bills) {
        int fives = 0;
        int tens = 0;
        for(int i=0;i<bills.length;i++){
            switch(bills[i]){
                case 5:
                fives++;
                break;
                case 10:
                if(fives == 0) return false;
                fives--;
                tens++;
                break;
                case 20:
                if(fives >=1 && tens >= 1){
                    fives--;
                    tens--;
                }
                else if(fives >= 3) fives -= 3;
                else return false;
                break;
            }
        }
        return true;
    }
}
