class Solution {
    public long subArrayRanges(int[] nums) {
       return sumSubarrayMax(nums) - sumSubarrayMin(nums);
    }

    public long sumSubarrayMax(int nums[]){
        int nge[] = findNGE(nums);
        int pgee[] = findPGEE(nums);
        long result = 0;

        for(int i=0;i<nums.length;i++){
            int left = i - pgee[i];
            int right = nge[i] - i;
            long sum = left * right * 1L * nums[i];
            result += sum;
        }
        return result;
    }

    public long sumSubarrayMin(int nums[]){
        int nse[] = findNSE(nums);
        int psee[] = findPSEE(nums);
        long result = 0;

        for(int i=0;i<nums.length;i++){
            int left = i - psee[i];
            int right = nse[i] - i;
            long sum = left * right * 1L * nums[i];
            result += sum;
        }
        return result;
    }
  
    public int[] findNSE(int nums[]){
        int result[] = new int[nums.length];
        Stack<Integer> st = new Stack<>();
        for(int i=nums.length-1;i>=0;i--){
            while(!st.isEmpty() && nums[i] < nums[st.peek()]) st.pop();
            result[i] = st.isEmpty() ? nums.length : st.peek();
            st.push(i);
        }
        return result;
    }

     public int[] findPSEE(int nums[]){
        int result[] = new int[nums.length];
        Stack<Integer> st = new Stack<>();
        for(int i=0;i<nums.length;i++){
            while(!st.isEmpty() && nums[i] <= nums[st.peek()]) st.pop();
            result[i] = st.isEmpty() ? -1 : st.peek();
            st.push(i);
        }
        return result;
    }

     public int[] findNGE(int nums[]){
        int result[] = new int[nums.length];
        Stack<Integer> st = new Stack<>();
        for(int i=nums.length-1;i>=0;i--){
            while(!st.isEmpty() && nums[i] > nums[st.peek()]) st.pop();
            result[i] = st.isEmpty() ? nums.length : st.peek();
            st.push(i);
        }
        return result;
    }

     public int[] findPGEE(int nums[]){
        int result[] = new int[nums.length];
        Stack<Integer> st = new Stack<>();
        for(int i=0;i<nums.length;i++){
            while(!st.isEmpty() && nums[i] >= nums[st.peek()]) st.pop();
            result[i] = st.isEmpty() ? -1 : st.peek();
            st.push(i);
        }
        return result;
    }

}
