class Solution {
    public int countPrimes(int n) {
        int result = 0;
        boolean isPrime[] = new boolean[n];
        for(int i=2;i<n;i++){
            isPrime[i] = true;
        }
        for(int p=2;p*p<n;p++){
            if(isPrime[p] == true){
                for(int i=p*p;i<n;i+=p){
                isPrime[i] = false;
            }
          }
        }
        for(int i=2;i<n;i++){
            if(isPrime[i] == true) result++;
        }
        return result;
    }
}
