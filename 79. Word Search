class Solution {
    public boolean exist(char[][] board, String word) {
        for(int i=0;i<board.length;i++){
            for(int j=0;j<board[0].length;j++){
                     if(isExist(0,i,j,board,word)) return true;
            }
        }
       return false;
    }

    public boolean isExist(int index,int i,int j,char board[][],String word){
        if(index == word.length()) return true;
        if(i<0 || i>=board.length || j<0 || j>=board[0].length || 
        word.charAt(index)!=board[i][j]) return false;
        char temp = board[i][j];
        board[i][j] = '#';
        boolean found = isExist(index+1, i+1, j, board, word) ||
                        isExist(index+1, i-1, j, board, word) ||
                        isExist(index+1, i, j+1, board, word) ||
                        isExist(index+1, i, j-1, board, word);
        board[i][j] = temp;
        return found;
    }
}
